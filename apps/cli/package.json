{
  "name": "@dxgjs/cli",
  "version": "0.0.0",
  "description": "DXG command-line interface",
  "type": "module",
  "bin": {
    "dxg": "./bin/index.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@dxgjs/config": "workspace:*",
    "@dxgjs/fs": "workspace:*",
    "@dxgjs/generators": "workspace:*",
    "@dxgjs/logger": "workspace:*",
    "@dxgjs/prompts": "workspace:*",
    "@dxgjs/templates": "workspace:*",
    "@dxgjs/terminal": "workspace:*",
    "@dxgjs/workspace": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@dxgjs/eslint-config": "workspace:*",
    "@dxgjs/typescript-config": "workspace:*",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
