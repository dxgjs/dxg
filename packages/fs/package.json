{
  "name": "@dxgjs/fs",
  "version": "0.1.0",
  "description": "Filesystem abstraction layer for DXG",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxgjs/dxg.git",
    "directory": "packages/fs"
  },
  "homepage": "https://github.com/dxgjs/dxg/tree/main/packages/fs#readme",
  "bugs": {
    "url": "https://github.com/dxgjs/dxg/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "package-manager-detector": "^1.8.0"
  },
  "devDependencies": {
    "@antfu/ni": "^30.5.0",
    "@dxgjs/eslint-config": "workspace:*",
    "@dxgjs/typescript-config": "workspace:*",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "execa": "^10.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
