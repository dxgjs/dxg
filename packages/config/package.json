{
  "name": "@dxgjs/config",
  "version": "0.0.0",
  "description": "Configuration loading and merging for DXG",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@dxgjs/fs": "workspace:*"
  },
  "devDependencies": {
    "@dxgjs/eslint-config": "workspace:*",
    "@dxgjs/typescript-config": "workspace:*",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
