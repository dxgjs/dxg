import "dotenv/config";
import { {{adapterImport}} } from "{{adapterPackage}}";
import { PrismaClient } from "../generated/prisma/client";

{{#if connectionString}}
const connectionString = `${process.env.DATABASE_URL}`;

const adapter = new {{adapterClass}}({ connectionString });
{{/if}}
{{#if individualParams}}
const adapter = new {{adapterClass}}({
  host: process.env.DATABASE_HOST,
  user: process.env.DATABASE_USER,
  password: process.env.DATABASE_PASSWORD,
  database: process.env.DATABASE_NAME,
  connectionLimit: 5,
});
{{/if}}
{{#if sqlserverParams}}
const sqlConfig = {
  user: process.env.DB_USER,
  password: process.env.DB_PASSWORD,
  database: process.env.DB_NAME,
  server: process.env.HOST,
  pool: {
    max: 10,
    min: 0,
    idleTimeoutMillis: 30000,
  },
  options: {
    encrypt: true, // for azure
    trustServerCertificate: false
  },
};

const adapter = new {{adapterClass}}(sqlConfig);
{{/if}}
{{#if planetscaleMysqlParams}}
import { fetch as undiciFetch } from "undici";

const adapter = new {{adapterClass}}({ url: process.env.DATABASE_URL, fetch: undiciFetch });
{{/if}}
const prisma = new PrismaClient({ adapter });

export { prisma };