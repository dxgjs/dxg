{
  "name": "@dxgjs/generators",
  "version": "0.1.0",
  "description": "Generator system for DXG",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@dxgjs/fs": "workspace:*",
    "@dxgjs/logger": "workspace:*",
    "@dxgjs/prompts": "workspace:*",
    "@dxgjs/templates": "workspace:*",
    "@dxgjs/workspace": "workspace:*",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@antfu/ni": "^30.5.0",
    "@dxgjs/eslint-config": "workspace:*",
    "@dxgjs/typescript-config": "workspace:*",
    "@types/node": "^26.2.0",
    "esbuild-plugin-copy": "^2.1.1",
    "eslint": "^10.8.1",
    "execa": "^10.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
