{
  "name": "@dxgjs/errors",
  "version": "0.1.0",
  "description": "DXG Error hierarchy and formatting utilities",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxgjs/dxg.git",
    "directory": "packages/errors"
  },
  "homepage": "https://github.com/dxgjs/dxg/tree/main/packages/errors#readme",
  "bugs": {
    "url": "https://github.com/dxgjs/dxg/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@dxgjs/eslint-config": "workspace:*",
    "@dxgjs/typescript-config": "workspace:*",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}