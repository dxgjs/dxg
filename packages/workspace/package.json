{
  "name": "@dxgjs/workspace",
  "version": "0.0.0",
  "description": "Workspace detection utilities for DXG",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@dxgjs/fs": "workspace:*",
    "@dxgjs/logger": "workspace:*"
  },
  "devDependencies": {
    "@dxgjs/eslint-config": "workspace:*",
    "@dxgjs/typescript-config": "workspace:*"
  }
}
